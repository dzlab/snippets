{
  "name": "jev-chess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env --import tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file=.env --import tsx src/server/index.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.2.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^8.2.2"
  }
}
